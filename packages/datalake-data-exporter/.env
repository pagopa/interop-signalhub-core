LOG_LEVEL=debug

DATALAKE_STORAGE_BUCKET=interop-datalake-bucket
S3_CUSTOM_SERVER=true
S3_SERVER_HOST=http://localhost
S3_SERVER_PORT=9000

AWS_CONFIG_FILE=aws.config.local

# DB connections
SH_DB_HOST="localhost"
SH_DB_NAME="signal-hub"
SH_DB_USERNAME="postgres"
SH_DB_PASSWORD="postgres"
SH_DB_PORT=5432
SH_DB_USE_SSL="false"

SH_DB_INTEROP_SCHEMA="DEV_INTEROP"
SH_DB_SIGNALHUB_SCHEMA="DEV_SIGNALHUB"
